{
  "$schema": "https://www.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "name": "Countdown Notification",
  "version": "1.0.0",
  "description": "Detects countdown timers on web pages and notifies you when they complete",
  "permissions": [
    "notifications",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
